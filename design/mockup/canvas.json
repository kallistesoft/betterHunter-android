hotoAnswerLight.dc.html","Settings.dc.html","Provinces.dc.html","About.dc.html","SettingsLight.dc.html","ProvincesLight.dc.html","AboutLight.dc.html","UpdateRequired.dc.html","UpdateRequiredLight.dc.html","Logos.dc.html","BuckVariants.dc.html"],"notes":{"exam-prep-title":{"x":0,"y":-260,"text":"Flow 1 — Working on it: from first launch to passing the real exam","kind":"title1","maxW":6500,"page":"exam-prep"},"exam-prep-light":{"x":0,"y":1040,"text":"Light mode","kind":"title1","maxW":6500,"page":"exam-prep"},"exam-prep-steps":{"x":0,"y":880,"w":2270,"text":"Steps: 1 splash → 2 “Working on it” → 3 what you hunt with (firearm, bow, crossbow) → 4 where you hunt (Québec, Alberta, elsewhere in Canada): the province sets the quizzes — Québec: Québec hunter course; Alberta: Alberta course + PAL; elsewhere: PAL → 5 Home → 6 Exam training → 7–8 practice and results (8b nothing to review) → 9–10 mock exam and results (9b quit) → 11 “I passed the real exam” → 12 Home as a new hunter.","color":"orange","size":"m","page":"exam-prep"},"what-is-it-title":{"x":0,"y":-260,"text":"Flow 3 — What is it? (game identification)","kind":"title1","maxW":1800,"page":"what-is-it"},"what-is-it-light":{"x":0,"y":1040,"text":"Light mode","kind":"title1","maxW":1800,"page":"what-is-it"},"what-is-it-steps":{"x":0,"y":880,"w":1800,"text":"From Home's “What is it?” tile: the hub → a photo question (tap the photo for full screen) → the answer card.","color":"orange","size":"m","page":"what-is-it"},"settings-title":{"x":0,"y":-260,"text":"Flow 4 — Settings and About","kind":"title1","maxW":1800,"page":"settings"},"settings-light":{"x":0,"y":1040,"text":"Light mode","kind":"title1","maxW":1800,"page":"settings"},"settings-steps":{"x":0,"y":880,"w":1330,"text":"Home's gear → Settings (hunter type, hunting with, where you hunt, language, daily goal) → My provinces (switch on another province to add its quizzes, or off to hide them) → About.","color":"orange","size":"m","page":"settings"},"system-title":{"x":0,"y":-260,"text":"Flow 5 — System screens","kind":"title1","maxW":1800,"page":"system"},"system-light":{"x":0,"y":1040,"text":"Light mode","kind":"title1","maxW":1800,"page":"system"},"system-steps":{"x":0,"y":880,"w":860,"text":"Shown instead of the app when this version is below the force-update minimum (Remote Config).","color":"orange","size":"m","page":"system"},"logo-title":{"x":0,"y":-260,"text":"Logo — the buck, and variants to make it ours","kind":"title1","maxW":2640,"page":"logo"},"new-hunter-title":{"x":0,"y":-260,"text":"Flow 2 — New hunter: first seasons, from first launch to field skills","kind":"title1","maxW":9320,"page":"new-hunter"},"new-hunter-light":{"x":0,"y":1040,"text":"Light mode","kind":"title1","maxW":9320,"page":"new-hunter"},"new-hunter-steps":{"x":0,"y":880,"w":4620,"text":"Steps: 1 “New hunter” → 2 what you hunt with → 3 where you hunt: the province sets the rules and game → 4 Home as a new hunter, to stay up to date: today’s 6 questions, 3 random species (photos, “What is it?”) and 3 random general (rules, safety, shot placement, tracking; 4b), then the What is it? and Field skills tiles; no exam → 5 Field skills: today’s mix (10 questions from the weakest skills) and readiness per skill — shot placement, after the shot, safe handling, rules in the field, survival → 6 skill question → 7 results, with the skill’s progress. Mastery: 8 a skill at 100% is mastered → 9 later, mastered skills show a check, and a skill whose right answers are over 3 months old fades back below 100%; each mix keeps 1–2 questions from mastered skills → 10 every skill mastered: the mix becomes “Keep your edge” → 11 the app doesn’t know legal season dates (zone, weapon, year): without a date, from late August Home says “Hunting season is coming” and offers to set your date → 11b you pick your first hunting day (check the official regulations) → 11c Home counts down to your date, 3 weeks before it → 12 the season check (15 questions, all skills).","color":"orange","size":"m","page":"new-hunter"},"new-hunter-reminders":{"x":7050,"y":880,"w":2270,"text":"Reminders (local notifications, scheduled on the phone, nothing sent to a server). Never asked at onboarding: 13 when today's 6 questions are done, or 15 right after saving a season date, each explaining why → 14 Android's permission dialog. At most one notification a day, never between 9 pm and 8 am, at the time this hunter usually plays (learned on the phone; 7 pm until then). The daily reminder is skipped once the questions are done. Season: 3 weeks and 1 day before the hunter's date. 16 Settings: switches for both, and the season start date. 17 how they look on the lock screen.","color":"orange","size":"m","page":"new-hunter"}},"designSystems":[]}